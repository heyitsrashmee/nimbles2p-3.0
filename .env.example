# WordPress REST API root (optional — defaults to https://nimbles2p.com/wp-json/wp/v2)
# NEXT_PUBLIC_WORDPRESS_API_URL=https://nimbles2p.com/wp-json/wp/v2

# Resources page WordPress.com posts endpoint (optional override)
# Also supports the older site-base format, but prefer the exact /posts endpoint.
# WORDPRESS_RESOURCES_API_BASE=https://public-api.wordpress.com/wp/v2/sites/resourcesnimbles2p.wordpress.com/posts

# Web3Forms — https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_get_started_access_key_here
NEXT_PUBLIC_WEB3FORMS_DEMO_ACCESS_KEY=your_book_demo_access_key_here
# Gated resource CTAs (product pages, WordPress guides) — https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_GATED_ACCESS_KEY=your_gated_download_access_key_here

# EmailJS — https://www.emailjs.com/ (optional; mailto fallback if unset)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_nimbles2p
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_demo_req
